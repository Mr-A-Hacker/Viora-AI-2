# Viora AI backend configuration
# Copy this file to .env and adjust as needed: cp .env.example .env

# Server
PORT=8000

# Paths (relative to project root)
CONVERSATIONS_FILE=conversations.json
TOOLS_PATH=tools.json
JOBS_FILE=task_jobs.json
LOCAL_DIR=./models
CAPTURES_DIR=captures

# Chat LLM (Qwen)
CHAT_REPO_ID=Qwen/Qwen3-0.6B-GGUF
CHAT_FILENAME=Qwen3-0.6B-Q8_0.gguf

# Tool LLM (Function Gemma)
TOOL_REPO_ID=nlouis/functiongemma-pocket-q4_k_m
TOOL_FILENAME=functiongemma-pocket-q4_k_m.gguf

# Speech-to-text
# USE_WHISPER=true
# USE_VOSK=true
# VOSK_MODEL=./models/vosk-model-small-en-us-0.15

# Text-to-speech
# PIPER_MODEL=en_US-lessac-medium.onnx

# Feature flags
# ENABLE_CAMERA=true
# ENABLE_TTS=true
# ENABLE_STT=true
# ENABLE_LLM=true
# ENABLE_HAILO=false

# Security (REQUIRED — set strong passwords in production!)
# SECURITY_PASSWORD=changeme
# SECRET_KEY=change-me-to-a-random-string
# SECURITY_SECRET=change-me-to-a-random-string

# Logging (optional): DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# LOG_FILE=
